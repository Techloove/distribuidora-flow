# Apenas no host administrativo. Arquivo real deve ser privado, fora do repositório.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/certs/postgres-ca.pem
EXT_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXT_SUPABASE_SERVICE_ROLE_KEY=
# Gere e guarde 32 bytes hexadecimais em um gerenciador de segredos.
ERP_BACKUP_KEY=
ERP_BACKUP_LOCAL=/var/lib/caparao-backups
ERP_BACKUP_EXTERNO=/mnt/caparao-backup
