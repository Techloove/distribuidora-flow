# Variáveis de ambiente do servidor.
# Nunca versionar .env com credenciais reais.

# Supabase usado pelas funções server-side.
EXT_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXT_SUPABASE_ANON_KEY=
# EXCLUSIVAMENTE no servidor. Nunca expor ao navegador.
EXT_SUPABASE_SERVICE_ROLE_KEY=

# Ambiente Sicredi.
SICREDI_AMBIENTE=homologacao

# Fallbacks server-side opcionais para Sicredi.
# A configuração persistida em public.sicredi_config é acessada apenas pelo servidor.
SICREDI_API_KEY=
SICREDI_USERNAME=
SICREDI_PASSWORD=
SICREDI_COOPERATIVA=
SICREDI_POSTO=
SICREDI_CODIGO_BENEFICIARIO=
